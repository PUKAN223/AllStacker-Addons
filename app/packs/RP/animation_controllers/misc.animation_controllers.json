{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.hams.ed_hanging_cow":{
			"states" : {
				"default" : {
					"transitions" : [
						{ "half": "query.mark_variant >= 5" }
					],
					"blend_transition": 0.25
				},
				"half": {
					"animations": [ "half" ]
				}
			}
		},
		"controller.animation.hams.ed_hanging_goat":{
			"states" : {
				"default" : {
					"transitions" : [
						{ "half": "query.mark_variant >= 4" }
					],
					"blend_transition": 0.25
				},
				"half": {
					"animations": [ "half" ]
				}
			}
		}
	}
}