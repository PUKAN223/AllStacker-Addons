{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.hams.ed_cattle.move": {
      "states": {
        "default": {
          "transitions": [
            { "idle": "query.ground_speed <= 0.4" },
            { "walk": "query.ground_speed > 0.6 && query.ground_speed <= 3.9" },
            { "run": "query.ground_speed > 4.0" },
            { "sprawl": "q.is_sheared" }
          ],
          "blend_transition": 0.25
        },
        "idle": {
          "animations": ["idle", "look_at_target"],
          "transitions": [
            { "walk": "query.ground_speed > 0.6 && query.ground_speed <= 3.9" },
            { "run": "query.ground_speed > 4.0" },
            { "sprawl": "q.is_sheared" }
          ],
          "blend_transition": 0.25
        },
        "walk": {
          "animations": [{ "walk": "!q.is_riding" }, "look_at_target"],
          "blend_transition": 0.25,
          "transitions": [
            { "idle": "query.ground_speed <= 0.4" },
            { "run": "query.ground_speed > 4.0" },
            { "sprawl": "q.is_sheared" }
          ]
        },
        "run": {
          "animations": [{ "run": "!q.is_riding" }, "look_at_target"],
          "blend_transition": 0.25,
          "transitions": [
            { "idle": "query.ground_speed <= 0.4" },
            { "walk": "query.ground_speed > 0.6 && query.ground_speed <= 3.9" },
            { "sprawl": "q.is_sheared" }
          ]
        },
        "sprawl": {
          "animations": ["sprawl", "idle"],
          "blend_transition": 0.25,
          "transitions": [{ "idle": "!q.is_sheared" }]
        }
      }
    }
  }
}
