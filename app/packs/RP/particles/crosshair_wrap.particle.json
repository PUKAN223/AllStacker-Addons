{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kisu:crosshair_wrap",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/crosshair"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true,
        "velocity": true
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 5
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0.5, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 5
      },
      "minecraft:particle_initial_speed": 0.2,
      "minecraft:particle_motion_parametric": {
        "rotation": "v.emitter_age*72"
      },
      "minecraft:particle_expire_if_in_blocks": ["minecraft:structure_void"],
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3+(math.cos((v.particle_age/v.particle_lifetime)*720)*0.125)",
          "0.3+(math.cos((v.particle_age/v.particle_lifetime)*720)*0.125)"
        ],
        "facing_camera_mode": "rotate_xyz"
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.47": "#FFFFFFFF",
            "1.0": "#FFFFFFFF"
          }
        }
      }
    }
  }
}
