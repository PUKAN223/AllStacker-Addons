{
  "namespace": "server_form",
  "main_screen_content": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
  "third_party_server_screen@common.base_screen_custom": {
    "$screen_content": "server_form.main_screen_content",
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },
  "custom_form@common_dialogs.main_panel_no_buttons": {
    "type": "panel",
    "controls": [
      {
        "default_custom_form@default.default_custom_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#title_text - $shop_prefix) = #title_text) and ((#title_text - 'smartphone') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "shop_custom_form@shop.shop_custom_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - $shop_prefix) = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_custom_form@common_dialogs.main_panel_no_buttons_smartphone": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 14px", 20],
          "size": [175, 250],
          "offset": [0, 22],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "smartphone_ui.custom_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'smartphone') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_home_button": {
          "type": "image",
          "texture": "textures/ui/smartphone_home_button",
          "size": [28, 28],
          "offset": [98, 205],
          "layer": 100,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'smartphone') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_home_background": {
          "type": "image",
          "texture": "textures/ui/smartphone_background",
          "size": [161.25, 175],
          "offset": [32, 23],
          "layer": 3,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#bank_transfer_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_bank')",
              "target_property_name": "#bank_transfer_text"
            },
            {
              "binding_name": "#discraft_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_discraft')",
              "target_property_name": "#discraft_text"
            },
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "((not ((#title_text - 'smartphone') = #title_text) or (#title_text = 'title.smartphone_bank' + #bank_transfer_text) or (#title_text = 'title.smartphone_discraft' + #discraft_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_bank_transfer_app_background": {
          "type": "image",
          "texture": "textures/ui/smartphone_default_app_background",
          "size": [161.25, 175],
          "offset": [32, 23],
          "layer": 4,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#bank_transfer_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_bank')",
              "target_property_name": "#bank_transfer_text"
            },
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'title.smartphone_bank' + #bank_transfer_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_discraft_app_background": {
          "type": "image",
          "texture": "textures/ui/smartphone_discraft_app_background",
          "size": [161.25, 175],
          "offset": [32, 23],
          "layer": 4,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#discraft_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_discraft')",
              "target_property_name": "#discraft_text"
            },
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'title.smartphone_discraft' + #discraft_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_upper_bar": {
          "type": "image",
          "texture": "textures/ui/smartphone_upper_bar",
          "size": [161.25, 62.5],
          "offset": [32, -17],
          "layer": 5,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'smartphone') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "bank_battery_label": {
          "type": "label",
          "size": ["default", 10],
          "color": "$f_color_format",
          "text": "#bank_transfer_text",
          "layer": 6,
          "offset": [37, -81],
          "shadow": true,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_name": "#bank_transfer_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_bank')",
              "target_property_name": "#bank_transfer_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'title.smartphone_bank' + #bank_transfer_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "discraft_battery_label": {
          "type": "label",
          "size": ["default", 10],
          "color": "$f_color_format",
          "text": "#discraft_text",
          "layer": 6,
          "offset": [37, -81],
          "shadow": true,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_name": "#discraft_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_discraft')",
              "target_property_name": "#discraft_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'title.smartphone_discraft' + #discraft_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "discraft_app_transfer_title": {
          "type": "label",
          "color": "$f_color_format",
          "layer": 8,
          "text": "text.discraft_title",
          "shadow": true,
          "font_type": "MinecraftTen",
          "font_size": "normal",
          "font_scale_factor": 1.6,
          "offset": [0, -58],
          "bindings": [
            {
              "binding_name": "#discraft_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_discraft')",
              "target_property_name": "#discraft_text"
            },
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'title.smartphone_discraft' + #discraft_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "long_form": {
    "type": "panel",
    "controls": [
      {
        "default_long_form@default.default_long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(((#title_text - $minimap_prefix) = #title_text) and (#title_text - $shop_prefix) = #title_text) and ((#title_text - $wallet_prefix) = #title_text) and ((#title_text - $action_prefix) = #title_text) and ((#title_text - 'smartphone') = #title_text) and ((#title_text - '§c§o§o§k§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "minimap@minimap.long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - $minimap_prefix) = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cooking@cooking.long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - $cooking_prefix) = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_long_form@common_dialogs.main_panel_no_buttons_smartphone": {
          "$title_panel": "smartphone_ui.smartphone_title_label",
          "size": [175, 250],
          "offset": [0, 22],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "smartphone_ui.smartphone_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'smartphone') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_home_button": {
          "type": "image",
          "texture": "textures/ui/smartphone_home_button",
          "size": [28, 28],
          "offset": [98, 205],
          "layer": 100,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'smartphone') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "smartphone_home_background": {
          "type": "image",
          "texture": "textures/ui/smartphone_background",
          "size": [161.25, 175],
          "offset": [32, 23],
          "layer": 4,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#appstore_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_appstore')",
              "target_property_name": "#appstore_text"
            },
            {
              "binding_name": "#store_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_store')",
              "target_property_name": "#store_text"
            },
            {
              "binding_name": "#store_items_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_itemsstore')",
              "target_property_name": "#store_items_text"
            },
            {
              "binding_name": "#bank_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_bank')",
              "target_property_name": "#bank_text"
            },
            {
              "binding_name": "#bank_deposite_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_deposite')",
              "target_property_name": "#bank_deposite_text"
            },
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((not (#title_text = 'title.smartphone_home')) or #title_text = 'title.smartphone_settings' or (#title_text = 'title.smartphone_appstore' + #appstore_text) or (#title_text = 'title.smartphone_store' + #store_text) or (#title_text = 'title.smartphone_itemsstore' + #store_items_text) or (#title_text = 'title.smartphone_bank' + #bank_text) or (#title_text = 'title.smartphone_deposite' + #bank_deposite_text) or #title_text = 'title.smartphone_music' or #title_text = 'title.smartphone_daynight' or #title_text = 'title.smartphone_weather' or #title_text = 'title.smartphone_effect') or #title_text = 'title.smartphone_discraft')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "apps_backgrounds@smartphone_ui.apps_backgrounds": {}
      },
      {
        "smartphone_upper_bar": {
          "type": "image",
          "texture": "textures/ui/smartphone_upper_bar",
          "size": [161.25, 62.5],
          "offset": [32, -17],
          "layer": 5,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - 'smartphone') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "action_long_form@actions.action_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - $action_prefix) = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "shop_long_form@shop.shop_long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - $shop_prefix) = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "wallet_long_form@wallet.wallet_long_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - $wallet_prefix) = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "dynamic_button": {
    "type": "stack_panel",
    "size": ["100%", 32],
    "orientation": "horizontal",
    "controls": [
      {
        "panel_name": {
          "type": "panel",
          "size": [34, "100%c"],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "image",
              "resolve_sibling_scope": true,
              "source_property_name": "(not (#texture = ''))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "image": {
                "type": "image",
                "layer": 2,
                "size": [32, 32],
                "offset": [0, 0],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "progress@progress.progress_loading_bars": {
                "size": [30, 4],
                "offset": [-2, 16],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "image",
                    "resolve_sibling_scope": true,
                    "source_property_name": "(#texture = 'loading')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "form_button@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": ["fill", 32],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": ["100%", 20],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "collection",
              "binding_collection_name": "form_buttons",
              "binding_condition": "none",
              "binding_name": "#form_button_text",
              "binding_name_override": "#form_button_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not((%.1s * #form_button_text) = ' '))",
              "target_property_name": "#enabled"
            }
          ]
        }
      }
    ]
  }
}
