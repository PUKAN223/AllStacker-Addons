{
  "namespace": "shop",
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
  "shop_custom_form": {
    "type": "stack_panel",
    "size": [200, 250],
    "orientation": "vertical",
    "controls": [
      {
        "background@default.background": {
          "size": ["100%", "80%"],
          "controls": [
            {
              "cornor@default.cornor": {
                "controls": [
                  {
                    "close_button@default.close_button": {}
                  }
                ]
              }
            },
            {
              "top_bar@default.top_bar": {
                "controls": [
                  {
                    "title": {
                      "type": "label",
                      "text": "#title",
                      "anchor_to": "center",
                      "anchor_from": "center",
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "('%.100s' * #title_text - '\t')",
                          "target_property_name": "#title"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "wrapper": {
                "type": "panel",
                "size": ["100%", "80%"],
                "offset": [0, 10],
                "controls": [
                  {
                    "item_icon": {
                      "type": "image",
                      "texture": "textures/ui/assets/button_default",
                      "size": [48, 48],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [10, 7],
                      "controls": [
                        {
                          "item_icon": {
                            "type": "image",
                            "texture": "#texture",
                            "size": ["80%", "80%"],
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "bindings": [
                              {
                                "binding_name": "#title_text"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(('%.250s' * #title_text) - ('%.100s' * #title_text) - '\t')",
                                "target_property_name": "#texture"
                              }
                            ]
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#title_text - '§s§e§l§l§r') = #title_text))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "scrolling_panel@common.scrolling_panel": {
                      "anchor_to": "left_middle",
                      "anchor_from": "left_middle",
                      "$show_background": false,
                      "offset": [7, 2],
                      "size": ["100%", "100%"],
                      "$scrolling_content": "default.default_generated_contents",
                      "$scroll_size": [0, 0],
                      "$scrolling_pane_size": ["100%", "100%"],
                      "$scrolling_pane_offset": [2, 0],
                      "$scroll_bar_right_padding_size": [0, 0],
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom_bar": {
          "type": "image",
          "texture": "textures/ui/assets/bottom_bar",
          "size": ["100%", "fill"],
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle",
          "controls": [
            {
              "submit_button@common_buttons.light_text_button": {
                "$pressed_button_name": "button.submit_custom_form",
                "anchor_from": "center",
                "anchor_to": "center",
                "size": ["90%", 32],
                "$button_text": "#submit_text",
                "$button_text_binding_type": "global",
                "$button_binding_condition": "once",
                "$default_button_texture": "textures/ui/assets/small_button",
                "$hover_button_texture": "textures/ui/assets/small_button",
                "$border_visible": false,
                "bindings": [
                  {
                    "binding_name": "#submit_button_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
