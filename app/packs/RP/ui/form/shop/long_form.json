{
  "namespace": "shop",
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
  "shop_long_form": {
    "type": "stack_panel",
    "size": [200, 250],
    "orientation": "vertical",
    "controls": [
      {
        "background@default.background": {
          "controls": [
            {
              "cornor@default.cornor": {
                "controls": [
                  {
                    "close_button@default.close_button": {}
                  }
                ]
              }
            },
            {
              "top_bar@default.top_bar": {
                "controls": [
                  {
                    "title": {
                      "type": "label",
                      "text": "#title_text",
                      "anchor_to": "center",
                      "anchor_from": "center",
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "wrapper": {
                "type": "panel",
                "size": ["100%", "80%"],
                "offset": [0, 10],
                "controls": [
                  {
                    "scrolling_panel@common.scrolling_panel": {
                      "anchor_to": "left_middle",
                      "anchor_from": "left_middle",
                      "$show_background": false,
                      "offset": [7, 2],
                      "size": ["100%", "100%"],
                      "$scrolling_content": "shop.custom_panel_main",
                      "$scroll_size": [0, 0],
                      "$scrolling_pane_size": ["100%", "100%"],
                      "$scrolling_pane_offset": [2, 0],
                      "$scroll_bar_right_padding_size": [0, 0],
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#title_text - '§m§t§r') = #title_text))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "scrolling_panel@common.scrolling_panel": {
                      "anchor_to": "left_middle",
                      "anchor_from": "left_middle",
                      "$show_background": false,
                      "offset": [7, 2],
                      "size": ["100%", "100%"],
                      "$scrolling_content": "default.custom_panel_main",
                      "$scroll_size": [0, 0],
                      "$scrolling_pane_size": ["100%", "100%"],
                      "$scrolling_pane_offset": [2, 0],
                      "$scroll_bar_right_padding_size": [0, 0],
                      "bindings": [
                        {
                          "binding_name": "#title_text"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "((#title_text - '§m§t§r') = #title_text)",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "bottom_bar": {
          "type": "image",
          "texture": "textures/ui/assets/bottom_bar",
          "size": ["100%", "fill"],
          "anchor_to": "bottom_middle",
          "anchor_from": "bottom_middle",
          "controls": [
            {
              "bottom_wrapper": {
                "type": "image",
                "anchor_to": "center",
                "anchor_from": "center",
                "texture": "textures/ui/assets/bottom_wrapper",
                "size": ["90%", "75%"],
                "offset": [0, 0],
                "controls": [
                  {
                    "panel": {
                      "type": "stack_panel",
                      "size": ["100%", "100%"],
                      "orientation": "vertical",
                      "controls": [
                        {
                          "body_text": {
                            "type": "label",
                            "size": ["100%", "60%"],
                            "text": "#form_text",
                            "anchor_to": "top_left",
                            "anchor_from": "top_left",
                            "offset": [5, 5],
                            "bindings": [
                              {
                                "binding_name": "#title_text"
                              }
                            ]
                          }
                        },
                        {
                          "button_panel": {
                            "type": "stack_panel",
                            "size": ["100%", "fill"],
                            "orientation": "horizontal",
                            "controls": [
                              {
                                "padding": {
                                  "type": "panel",
                                  "size": [7, "100%"]
                                }
                              },
                              {
                                "content": {
                                  "type": "stack_panel",
                                  "size": ["100%", "100%"],
                                  "orientation": "horizontal",
                                  "collection_name": "form_buttons",
                                  "controls": [
                                    {
                                      "offset_button@shop.bottom_button": {
                                        "size": ["45%", "100%"],
                                        "collection_index": 0
                                      }
                                    },
                                    {
                                      "padding": {
                                        "type": "panel",
                                        "size": [4, "100%"]
                                      }
                                    },
                                    {
                                      "offset_button@shop.bottom_button": {
                                        "size": ["45%", "100%"],
                                        "collection_index": 1
                                      }
                                    }
                                  ]
                                }
                              }
                            ],
                            "bindings": [
                              {
                                "binding_name": "#title_text"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(not ((#title_text - '§a§d§m') = #title_text))",
                                "target_property_name": "#visible"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "bottom_button": {
    "$default_button_texture": "textures/ui/assets/small_button",
    "$hover_button_texture": "textures/ui/assets/small_button",
    "$pressed_button_texture": "textures/ui/assets/small_button",
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "main_ui": {
          "type": "panel",
          "size": ["100%", "100%"],
          "controls": [
            {
              "panel_name": {
                "type": "panel",
                "size": ["100%", "100%"],
                "controls": [
                  {
                    "image": {
                      "type": "image",
                      "layer": 200,
                      "size": ["20%", "55%"],
                      "offset": [6, -2],
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "bindings": [
                        {
                          "binding_name": "#form_button_texture",
                          "binding_name_override": "#texture",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_name": "#form_button_texture_file_system",
                          "binding_name_override": "#texture_file_system",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "text": {
                      "type": "label",
                      "text": "#form_button_text",
                      "layer": 32,
                      "offset": [2, -1],
                      "color": [1, 1, 1],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "bindings": [
                        {
                          "binding_name": "#form_button_text",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "form_button@common_buttons.light_text_button": {
                "$pressed_button_name": "button.form_button_click",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100%", 20],
                "$button_text": "#null",
                "$button_text_binding_type": "collection",
                "$button_text_grid_collection_name": "form_buttons",
                "$button_text_max_size": ["100%", 20],
                "$border_visible": false,
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
