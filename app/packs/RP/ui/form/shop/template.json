{
  "namespace": "shop",
  "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
  "custom_panel_main": {
    "type": "stack_panel",
    "size": ["90%", "100%c"],
    "orientation": "vertical",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [0, 0],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "@shop.custom_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "custom_button": {
    "type": "stack_panel",
    "size": ["100%", 40],
    "anchor_to": "left_middle",
    "anchor_from": "left_middle",
    "controls": [
      {
        "content": {
          "type": "panel",
          "size": ["100%", 35],
          "controls": [
            {
              "panel_name": {
                "type": "stack_panel",
                "size": ["100%", 35],
                "offset": [0, 4],
                "orientation": "horizontal",
                "controls": [
                  {
                    "image_wrapper": {
                      "type": "stack_panel",
                      "size": [30, "100%"],
                      "orientation": "vertical",
                      "controls": [
                        {
                          "padding": {
                            "type": "panel",
                            "size": ["100%", 5]
                          }
                        },
                        {
                          "image": {
                            "type": "image",
                            "layer": 200,
                            "size": ["100%", "60%"],
                            "bindings": [
                              {
                                "binding_name": "#form_button_texture",
                                "binding_name_override": "#texture",
                                "binding_type": "collection",
                                "binding_collection_name": "form_buttons"
                              },
                              {
                                "binding_name": "#form_button_texture_file_system",
                                "binding_name_override": "#texture_file_system",
                                "binding_type": "collection",
                                "binding_collection_name": "form_buttons"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                                "target_property_name": "#visible"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  {
                    "text_wrapper": {
                      "type": "stack_panel",
                      "size": ["100%", "100%"],
                      "orientation": "vertical",
                      "controls": [
                        {
                          "padding": {
                            "type": "panel",
                            "size": ["100%", 3]
                          }
                        },
                        {
                          "text": {
                            "type": "label",
                            "text": "#form_button_text",
                            "layer": 32,
                            "color": [1, 1, 1],
                            "anchor_from": "left_middle",
                            "bindings": [
                              {
                                "binding_name": "#form_button_text",
                                "binding_type": "collection",
                                "binding_collection_name": "form_buttons"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "price": {
                "type": "label",
                "layer": 12,
                "text": "#btn_price",
                "anchor_from": "center",
                "anchor_to": "center",
                "text_alignment": "right",
                "offset": [10, 0],
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(('%.150s' * #form_button_text) - ('%.100s' * #form_button_text) - '\t')",
                    "target_property_name": "#btn_price"
                  }
                ]
              }
            },
            {
              "button": {
                "type": "image",
                "size": ["100%", "100%"],
                "texture": "textures/ui/assets/button_default",
                "controls": [
                  {
                    "content": {
                      "type": "panel",
                      "size": ["25%", "60%"],
                      "anchor_from": "right_middle",
                      "anchor_to": "right_middle",
                      "offset": [-10, 0],
                      "controls": [
                        {
                          "button_text": {
                            "type": "label",
                            "text": "#btn_txt",
                            "size": ["100%", "100%"],
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "offset": [8, 5],
                            "layer": 10,
                            "bindings": [
                              {
                                "binding_name": "#form_button_text",
                                "binding_type": "collection",
                                "binding_collection_name": "form_buttons"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(#form_button_text - ('%.150s' * #form_button_text) - '\t')",
                                "target_property_name": "#btn_txt"
                              }
                            ]
                          }
                        },
                        {
                          "form_button@common_buttons.light_text_button": {
                            "$default_button_texture": "textures/ui/assets/green_button_default",
                            "$hover_button_texture": "textures/ui/assets/green_button_pressed",
                            "$pressed_button_texture": "textures/ui/assets/green_button_pressed",
                            "$pressed_button_name": "button.form_button_click",
                            "size": ["100%", "100%"],
                            "$border_visible": false,
                            "$button_text": "#null",
                            "$button_text_binding_type": "collection",
                            "$button_text_grid_collection_name": "form_buttons",
                            "$button_text_max_size": ["100%", 20],
                            "bindings": [
                              {
                                "binding_type": "collection_details",
                                "binding_collection_name": "form_buttons"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": ["100%", 5]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#form_button_text - '§h§r') = #form_button_text)",
        "target_property_name": "#visible"
      }
    ]
  }
}
