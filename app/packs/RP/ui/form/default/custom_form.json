{
    "namespace": "default",
    "default_custom_form": {
        "type": "stack_panel",
        "size": [
            200,
            250
        ],
        "orientation": "vertical",
        "controls": [
            {
                "background@default.background": {
                    "size": [
                        "100%",
                        "80%"
                    ],
                    "controls": [
                        {
                            "cornor@default.cornor": {
                                "controls": [
                                    {
                                        "close_button@default.close_button": {}
                                    }
                                ]
                            }
                        },
                        {
                            "top_bar@default.top_bar": {
                                "controls": [
                                    {
                                        "title": {
                                            "type": "label",
                                            "text": "#title_text",
                                            "anchor_to": "center",
                                            "anchor_from": "center",
                                            "bindings": [
                                                {
                                                    "binding_name": "#title_text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "wrapper": {
                                "type": "panel",
                                "size": [
                                    "100%",
                                    "80%"
                                ],
                                "offset": [
                                    0,
                                    10
                                ],
                                "controls": [
                                    {
                                        "scrolling_panel@common.scrolling_panel": {
                                            "anchor_to": "left_middle",
                                            "anchor_from": "left_middle",
                                            "$show_background": false,
                                            "offset": [
                                                7,
                                                2
                                            ],
                                            "size": [
                                                "100%",
                                                "100%"
                                            ],
                                            "$scrolling_content": "default.default_generated_contents",
                                            "$scroll_size": [
                                                0,
                                                0
                                            ],
                                            "$scrolling_pane_size": [
                                                "100%",
                                                "100%"
                                            ],
                                            "$scrolling_pane_offset": [
                                                2,
                                                0
                                            ],
                                            "$scroll_bar_right_padding_size": [
                                                0,
                                                0
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "bottom_bar": {
                    "type": "image",
                    "texture": "textures/ui/assets/bottom_bar",
                    "size": [
                        "100%",
                        "fill"
                    ],
                    "anchor_to": "bottom_middle",
                    "anchor_from": "bottom_middle",
                    "controls": [
                        {
                            "submit_button@common_buttons.light_text_button": {
                                "$pressed_button_name": "button.submit_custom_form",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "size": [
                                    "90%",
                                    32
                                ],
                                "$button_text": "#submit_text",
                                "$button_text_binding_type": "global",
                                "$button_binding_condition": "once",
                                "$default_button_texture": "textures/ui/shop_form/submit_button_default",
                                "$hover_button_texture": "textures/ui/shop_form/submit_button_hover",
                                "$border_visible": false,
                                "bindings": [
                                    {
                                        "binding_name": "#submit_button_visible",
                                        "binding_name_override": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    }
}