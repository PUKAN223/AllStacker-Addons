{
  "namespace": "cooking",
  "custom_panel_main": {
    "type": "panel",
    "size": ["90%", "100%c"],
    "controls": [
      {
        "long_form_dynamic_buttons_panel": {
          "type": "grid",
          "size": ["100%", "100%c"],
          "grid_item_template": "cooking.custom_button",
          "grid_rescaling_type": "horizontal",
          "grid_fill_direction": "horizontal",
          "anchor_from": "center",
          "anchor_to": "center",

          "factory": {
            "name": "buttons",
            "control_name": "cooking.custom_button"
          },

          "collection_name": "form_buttons",
          "bindings": [
            {
              "binding_name": "#form_button_length",
              "binding_condition": "once",
              "binding_name_override": "#maximum_grid_items"
            }
          ]
        }
      }
    ]
  },
  "custom_button": {
    "type": "stack_panel",
    "size": [70, 70],
    "anchor_to": "center",
    "anchor_from": "center",
    "controls": [
      {
        "content": {
          "type": "panel",
          "size": ["100%", 65],
          "controls": [
            {
              "image": {
                "type": "image",
                "layer": 200,
                "anchor_to": "center",
                "anchor_from": "center",
                "offset": [0, -10],
                "size": [30, "70%"],
                "bindings": [
                  {
                    "binding_name": "#form_button_texture",
                    "binding_name_override": "#texture",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_name": "#form_button_texture_file_system",
                    "binding_name_override": "#texture_file_system",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "text": {
                "type": "label",
                "text": "#form_button_text",
                "layer": 32,
                "color": [1, 1, 1],
                "anchor_to": "center",
                "anchor_from": "center",
                "text_alignment": "center",
                "offset": [0, 15],
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            },
            {
              "button_selected": {
                "type": "panel",
                "controls": [
                  {
                    "form_button@common_buttons.light_text_button": {
                      "$default_button_texture": "textures/ui/assets/button_pressed",
                      "$hover_button_texture": "textures/ui/assets/button_pressed",
                      "$pressed_button_texture": "textures/ui/assets/button_pressed",
                      "$locked_button_texture": "textures/ui/assets/button_pressed",
                      "$pressed_button_name": "button.form_button_click",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "size": ["100%", "100%"],
                      "$border_visible": false,
                      "$button_text": "#null",
                      "$button_text_binding_type": "collection",
                      "$button_text_grid_collection_name": "form_buttons",
                      "$button_text_max_size": ["100%", 20],
                      "enabled": false,
                      "bindings": [
                        {
                          "binding_type": "collection_details",
                          "binding_collection_name": "form_buttons"
                        }
                      ]
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_condition": "once",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "once",
                    "source_property_name": "(not ((#form_button_text - '§m§t§r') = #form_button_text))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "button_default": {
                "type": "panel",
                "controls": [
                  {
                    "form_button@common_buttons.light_text_button": {
                      "$default_button_texture": "textures/ui/assets/button_default",
                      "$hover_button_texture": "textures/ui/assets/button_pressed",
                      "$pressed_button_texture": "textures/ui/assets/button_pressed",
                      "$pressed_button_name": "button.form_button_click",
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "size": ["100%", "100%"],
                      "$border_visible": false,
                      "$button_text": "#null",
                      "$button_text_binding_type": "collection",
                      "$button_text_grid_collection_name": "form_buttons",
                      "$button_text_max_size": ["100%", 20],
                      "bindings": [
                        {
                          "binding_type": "collection_details",
                          "binding_condition": "once",
                          "binding_collection_name": "form_buttons"
                        }
                      ]
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_condition": "once",
                    "binding_collection_name": "form_buttons"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "once",
                    "source_property_name": "((#form_button_text - '§m§t§r') = #form_button_text)",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": ["100%", 5]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_condition": "once",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "binding_condition": "once",
        "source_property_name": "(not ((#form_button_text - '§j§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "ingredient_panel_main": {
    "type": "stack_panel",
    "size": ["90%", "100%c"],
    "orientation": "vertical",
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [0, 0],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "@cooking.ingredient_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "ingredient_button": {
    "type": "stack_panel",
    "size": ["100%", 30],
    "anchor_to": "left_middle",
    "anchor_from": "left_middle",
    "controls": [
      {
        "content": {
          "type": "panel",
          "size": ["100%", 25],
          "controls": [
            {
              "panel_name": {
                "type": "stack_panel",
                "size": ["100%", 25],
                "offset": [0, 4],
                "orientation": "horizontal",
                "controls": [
                  {
                    "image": {
                      "type": "image",
                      "layer": 200,
                      "size": [30, "70%"],
                      "bindings": [
                        {
                          "binding_name": "#form_button_texture",
                          "binding_name_override": "#texture",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_name": "#form_button_texture_file_system",
                          "binding_name_override": "#texture_file_system",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        },
                        {
                          "binding_type": "view",
                          "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                          "target_property_name": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "label": {
                      "type": "panel",
                      "size": ["100%", "100%"],
                      "controls": [
                        {
                          "text_wrapper": {
                            "type": "stack_panel",
                            "size": ["100%", "100%"],
                            "orientation": "vertical",
                            "controls": [
                              {
                                "padding": {
                                  "type": "panel",
                                  "size": ["100%", 5]
                                }
                              },
                              {
                                "text": {
                                  "type": "label",
                                  "text": "#text",
                                  "layer": 32,
                                  "color": [1, 1, 1],
                                  "anchor_from": "left_middle",
                                  "bindings": [
                                    {
                                      "binding_name": "#form_button_text",
                                      "binding_type": "collection",
                                      "binding_collection_name": "form_buttons"
                                    },
                                    {
                                      "binding_type": "view",
                                      "source_property_name": "('%.100s' * #form_button_text - '\t')",
                                      "target_property_name": "#text"
                                    }
                                  ]
                                }
                              }
                            ]
                          }
                        },
                        {
                          "quantity": {
                            "type": "label",
                            "text": "#quantity",
                            "layer": 32,
                            "color": [1, 1, 1],
                            "anchor_from": "center",
                            "anchor_to": "center",
                            "offset": [25, -2],
                            "bindings": [
                              {
                                "binding_name": "#form_button_text",
                                "binding_type": "collection",
                                "binding_collection_name": "form_buttons"
                              },
                              {
                                "binding_type": "view",
                                "source_property_name": "(('%.200s' * #form_button_text) - ('%.101s' * #form_button_text) - '\t')",
                                "target_property_name": "#quantity"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "form_button@common_buttons.light_text_button": {
                "$default_button_texture": "textures/ui/assets/item_wrapper",
                "$hover_button_texture": "textures/ui/assets/item_wrapper",
                "$pressed_button_texture": "textures/ui/assets/item_wrapper",
                "$locked_button_texture": "textures/ui/assets/item_wrapper",
                "$pressed_button_name": "button.form_button_click",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100%", "100%"],
                "$border_visible": false,
                "$button_text": "#null",
                "enabled": false,
                "$button_text_binding_type": "collection",
                "$button_text_grid_collection_name": "form_buttons",
                "$button_text_max_size": ["100%", 20],
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": ["100%", 5]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§i§n§g§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "cook_button": {
    "type": "stack_panel",
    "size": ["100%", 45],
    "anchor_to": "center",
    "anchor_from": "center",
    "controls": [
      {
        "content": {
          "type": "panel",
          "size": ["100%", 40],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "panel_name": {
                "type": "panel",
                "size": ["100%", "100%"],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "text": {
                      "type": "label",
                      "text": "#form_button_text",
                      "layer": 32,
                      "color": [1, 1, 1],
                      "text_alignment": "center",
                      "font_size": "medium",
                      "font_scale_factor": 1.5,
                      "bindings": [
                        {
                          "binding_name": "#form_button_text",
                          "binding_type": "collection",
                          "binding_collection_name": "form_buttons"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "form_button@common_buttons.light_text_button": {
                "$default_button_texture": "textures/ui/assets/green_button_default",
                "$hover_button_texture": "textures/ui/assets/green_button_pressed",
                "$pressed_button_texture": "textures/ui/assets/green_button_pressed",
                "$locked_button_texture": "textures/ui/assets/small_button",
                "$pressed_button_name": "button.form_button_click",
                "anchor_from": "center",
                "anchor_to": "center",
                "size": ["100%", "100%"],
                "$border_visible": false,
                "$button_text": "#null",
                "$button_text_binding_type": "collection",
                "$button_text_grid_collection_name": "form_buttons",
                "$button_text_max_size": ["100%", 30],
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": ["100%", 5]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§c§o§o§k§l§k') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  }
}
