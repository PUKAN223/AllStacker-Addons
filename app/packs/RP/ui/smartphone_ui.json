{
  "namespace": "smartphone_ui",
  // "$schema": "https://kalmemarq.github.io/Bugrock-JSON-UI-Schemas/ui.schema.json",
  "custom_form_panel@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": ["90%", "65% - 1px"],
    "$scrolling_content": "server_form.custom_form_scrolling_content",
    "$scroll_size": [5, "100% - 4px"],
    "$scrolling_pane_size": ["100% - 4px", "100% - 2px"],
    "$scrolling_pane_offset": [10, 34],
    "$scroll_bar_right_padding_size": [0, 0]
  },
  "smartphone_title_label": {
    "type": "label",
    "size": ["default", 0],
    "offset": [0, 0],
    "color": "$title_text_color",
    "text": "$text_name",
    "layer": 10,
    "shadow": false,
    "property_bag": {
      "#tts_dialog_title": "$text_name"
    }
  },
  "smartphone_form_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%"],
    "orientation": "vertical",
    "layer": 6,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "label_offset_panel": {
          "type": "panel",
          "size": ["100%", "100%c"],
          "controls": [
            {
              "main_label": {
                "type": "label",
                "offset": [4, -9],
                "color": "$main_header_text_color",
                "size": ["100%", "default"],
                "shadow": true,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "text": "#form_text"
              }
            },
            {
              "bank_money_label": {
                "type": "label",
                "size": ["default", 10],
                "color": "$f_color_format",
                "text": "#newtext",
                "text_alignment": "left",
                "layer": 7,
                "offset": [-25, -14],
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#newtext"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text - 'title.smartphone_bank')",
                    "target_property_name": "#newtext"
                  },
                  {
                    "binding_name": "#title_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text = 'title.smartphone_bank' + #newtext)",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "bank_deposite_money_label": {
                "type": "label",
                "size": ["default", 10],
                "color": "$f_color_format",
                "text": "#newtext",
                "text_alignment": "left",
                "layer": 7,
                "offset": [-25, -14],
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#newtext"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text - 'title.smartphone_deposite')",
                    "target_property_name": "#newtext"
                  },
                  {
                    "binding_name": "#title_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text = 'title.smartphone_deposite' + #newtext)",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "appstore_money_label": {
                "type": "label",
                "size": ["default", 10],
                "color": "$f_color_format",
                "text": "#newtext",
                "text_alignment": "left",
                "layer": 7,
                "offset": [-25, -14],
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#newtext"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text - 'title.smartphone_appstore')",
                    "target_property_name": "#newtext"
                  },
                  {
                    "binding_name": "#title_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text = 'title.smartphone_appstore' + #newtext)",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "store_money_label": {
                "type": "label",
                "size": ["default", 10],
                "color": "$f_color_format",
                "text": "#newtext",
                "text_alignment": "left",
                "layer": 7,
                "offset": [-25, -14],
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#newtext"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text - 'title.smartphone_store')",
                    "target_property_name": "#newtext"
                  },
                  {
                    "binding_name": "#title_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text = 'title.smartphone_store' + #newtext)",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "store_items_money_label": {
                "type": "label",
                "size": ["default", 10],
                "color": "$f_color_format",
                "text": "#newtext",
                "text_alignment": "left",
                "layer": 7,
                "offset": [-25, -14],
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#newtext"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text - 'title.smartphone_itemsstore')",
                    "target_property_name": "#newtext"
                  },
                  {
                    "binding_name": "#title_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#title_text = 'title.smartphone_itemsstore' + #newtext)",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "wrapper": {
          "type": "panel",
          "size": ["100%", 137],
          "controls": [
            {
              "default_scrolling_panel@common.scrolling_panel": {
                "anchor_to": "top_middle",
                "anchor_from": "top_middle",
                "$show_background": false,
                "size": ["100%", "100%"],
                "offset": [18, 5],
                "$scrolling_content": "smartphone_ui.default_smartphone_form_scrolling_content",
                "$scroll_size": [1, "100% - 4px"],
                "$scrolling_pane_size": ["100% - 5px", "100% - 2px"],
                "$scrolling_pane_offset": [0, 0],
                "$scroll_bar_right_padding_size": [0, 0]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#appstore_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_appstore')",
              "target_property_name": "#appstore_text"
            },
            {
              "binding_name": "#store_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_store')",
              "target_property_name": "#store_text"
            },
            {
              "binding_name": "#store_items_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_itemsstore')",
              "target_property_name": "#store_items_text"
            },
            {
              "binding_name": "#bank_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_bank')",
              "target_property_name": "#bank_text"
            },
            {
              "binding_name": "#bank_deposite_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'title.smartphone_deposite')",
              "target_property_name": "#bank_deposite_text"
            },
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#title_text = 'title.smartphone_settings' or (#title_text = 'title.smartphone_appstore' + #appstore_text) or (#title_text = 'title.smartphone_store' + #store_text) or (#title_text = 'title.smartphone_itemsstore' + #store_items_text) or (#title_text = 'title.smartphone_bank' + #bank_text) or (#title_text = 'title.smartphone_deposite' + #bank_deposite_text) or #title_text = 'title.smartphone_music' or #title_text = 'title.smartphone_daynight' or #title_text = 'title.smartphone_weather' or #title_text = 'title.smartphone_effect') or #title_text = 'title.smartphone_discraft')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "scrolling_panel_settings_app@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": ["100%", 165],
          "$scrolling_content": "settings_app.smartphone_form_settings_app_scrolling_content",
          "$scroll_size": [1, "100% - 4px"],
          "$scrolling_pane_size": ["100% - 2px", "100% - 2px"],
          "$scrolling_pane_offset": [0, 0],
          "$scroll_bar_right_padding_size": [0, 0],
          "bindings": [
            {
              "binding_name": "#form_button_length",
              "binding_name_override": "#maximum_grid_items"
            },
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'title.smartphone_settings')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "scrolling_panel_appstore_app@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": ["100%", 113],
