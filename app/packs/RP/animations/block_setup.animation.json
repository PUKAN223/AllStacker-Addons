{
	"format_version": "1.8.0",
	"animations": {
		"animation.hams.setup0": {
			"loop": true,
			"bones": {
				"root": {
					"rotation": [0, "-query.body_y_rotation + (Math.round(query.body_y_rotation / 90) * 90)", 0]
				}
			}
		},
		"animation.hams.setup1": {
			"loop": true,
			"bones": {
				"root": {
					"rotation": [0, "math.round(query.body_y_rotation / v.d_rotation) * v.d_rotation - query.body_y_rotation", 0]
				}
			}
		}
	}
}