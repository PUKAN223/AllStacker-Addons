{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.fishing_rod.player.mnp_ci": {
      "geometry": "v.is_first_person ? geometry.fp_base : geometry.tp_base",
      "textures": ["texture.default"],
      "materials": [{ "*": "material.default" }, { "*_line": "material.line" }, { "*bobber*": "material.bobber" }],
      "part_visibility": [
        { "*": "!v.is_holding_fish" },

        { "*line*": false },

        { "rod_line1_2": false },
        { "rod_line2_2": false },
        { "rod_bobber": "!v.is_casted && !v.is_holding_fish" },

        { "line_bobber1": "v.is_casted && !q.is_in_ui && !v.is_paperdoll && !v.is_holding_fish" },

        { "spin_reel0": "v.reel_mod <= 0.25 && !v.is_holding_fish" },
        { "spin_reel1": "v.reel_mod > 0.25 && v.reel_mod <= 0.5 && !v.is_holding_fish" },
        { "spin_reel2": "v.reel_mod > 0.5 && v.reel_mod <= 0.75 && !v.is_holding_fish" },
        { "spin_reel3": "v.reel_mod > 0.75 && !v.is_holding_fish" },

        { "spin_reel0_line": "v.reel_mod2 <= 0.25 && !v.is_holding_fish" },
        { "spin_reel1_line": "v.reel_mod2 > 0.25 && v.reel_mod2 <= 0.5 && !v.is_holding_fish" },
        { "spin_reel2_line": "v.reel_mod2 > 0.5 && v.reel_mod2 <= 0.75 && !v.is_holding_fish" },
        { "spin_reel3_line": "v.reel_mod2 > 0.75 && !v.is_holding_fish" },

        { "*cancel": false },{ "*cancel1": false },{ "*test": false },
        { "*cancel2": false },{ "*cancel3": false },{ "*test2": false },
        { "debug_line": false }
      ]
    },
