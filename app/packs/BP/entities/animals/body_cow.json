{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "component_groups": {
      "hams:despawn": { "minecraft:instant_despawn": {} },
      "variant1": { "minecraft:variant": { "value": 0 } },
      "variant2": { "minecraft:variant": { "value": 1 } },
      "variant3": { "minecraft:variant": { "value": 2 } }
    },
    "components": {
      "minecraft:collision_box": { "height": 0.6, "width": 0.8 },
      "minecraft:damage_sensor": {
        "triggers": { "cause": "all", "deals_damage": false }
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.pickup",
            "on_interact": {
              "event": "hams:pickup",
              "filters": {
                "subject": "other",
                "test": "is_family",
                "value": "player"
              }
            }
          }
        ]
      },
      "minecraft:knockback_resistance": { "max": 0.4, "value": 0.4 },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": true
      },
      "minecraft:scale": { "value": 1.2 },
      "minecraft:type_family": { "family": ["body_cow"] }
    },
    "description": {
      "identifier": "hams:ed_body_cow",
      "is_experimental": false,
      "is_spawnable": false,
      "is_summonable": true
    },
    "events": {
      "hams:pickup": {
        "sequence": [
          { "add": { "component_groups": ["hams:despawn"] } },
          {
            "filters": { "subject": "self", "test": "is_variant", "value": 0 },
            "queue_command": { "command": ["give @p hams:ed_cow1_spawn_egg"] }
          },
          {
            "filters": { "subject": "self", "test": "is_variant", "value": 1 },
            "queue_command": { "command": ["give @p hams:ed_cow2_spawn_egg"] }
          },
          {
            "filters": { "subject": "self", "test": "is_variant", "value": 2 },
            "queue_command": { "command": ["give @p hams:ed_cow3_spawn_egg"] }
          }
        ]
      },
      "hams:variant1": { "add": { "component_groups": ["variant1"] } },
      "hams:variant2": { "add": { "component_groups": ["variant2"] } },
      "hams:variant3": { "add": { "component_groups": ["variant3"] } }
    }
  }
}
